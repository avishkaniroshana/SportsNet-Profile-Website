package com.sports.sportsnet.repository;

import com.sports.sportsnet.entity.Achievement;
import org.springframework.data.jpa.repository.JpaRepository;

import java.util.List;
import java.util.Optional;
import java.util.UUID;

public interface AchievementRepository extends JpaRepository<Achievement, UUID> {
    // by sport profile instead of user directly
    List<Achievement> findBySportProfile_Id(UUID sportProfileId);
    Optional<Achievement> findByIdAndSportProfile_Id(UUID id, UUID sportProfileId);
}



